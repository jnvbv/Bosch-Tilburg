/***********************************************************************
  SIMPL+ Module Information
  (Fill in comments below)
***********************************************************************/
digital_input fast_updates;
string_output time$, date$;

function Run()
{
	string dd_mm_yyyy$[20], day$[2], month$[2], year$[4];

	while(1)
	{
		time$ = mid(time(), 1, 5);

		dd_mm_yyyy$	= mid(date(2), 1, 10);
		day$ 		= mid(dd_mm_yyyy$, 1, 2);
		month$ 		= mid(dd_mm_yyyy$, 4, 2);
		year$ 		= mid(dd_mm_yyyy$, 7, 4);
            
		date$ = day$ + "-" + month$ + "-" + year$;

		if(fast_updates)
			delay(50);
		else		
			delay(500);
    }    
}

function Main()
{
	delay(1000);
	call Run();
}
